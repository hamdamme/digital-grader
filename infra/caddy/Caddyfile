# Production edge for Digital Grader.
# Serves the built SPA from /var/www/grader and proxies the API to the backend.
# TLS certificates are issued and renewed automatically for the managed domain.
grader.hamdam.me {
	root * /var/www/grader
	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
