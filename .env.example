# Run python3 scripts/init-dev-env.py to generate a local .env with random secrets.
DB_NAME=digital-grader
DB_USERNAME=digital-grader
DB_PASSWORD=replace_with_generated_secret
DB_PORT=15432
DB_URL=jdbc:postgresql://127.0.0.1:15432/digital-grader
SUBMISSION_QUEUE=digital-grader.submissions
RABBIT_HOST=127.0.0.1
RABBIT_PORT=5673
RABBIT_MANAGEMENT_PORT=15673
RABBIT_USERNAME=digital-grader
RABBIT_PASSWORD=replace_with_generated_secret
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ACCESS_KEY=digital-grader-local
MINIO_SECRET_KEY=replace_with_generated_secret
MINIO_BUCKET=submissions
JWT_SECRET=replace_with_generated_secret
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5176

# Optional first-admin bootstrap. Leave empty unless deliberately provisioning an admin.
# Remove these values from your private .env after first successful startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional security worker. Use an absolute path to a current vulnerability snapshot.
SECURITY_IMAGE=digital-grader-security:local
SECURITY_DATABASE_PATH=

# Hint requests transmit selected test errors and finding locations to this provider.
# Disabled by default. Configure a model explicitly; do not commit API keys.
AI_ENABLED=false
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=
AI_API_KEY=
